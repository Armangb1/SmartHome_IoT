# Copy to backend/.env and fill in real values.
# Used automatically by Django (python-dotenv) when running outside Docker.

DJANGO_SECRET_KEY=django-insecure-dev-key-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=sweetsignal
INFLUXDB_BUCKET=IOT-buck
INFLUXDB_TOKEN=my-super-secret-admin-token

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASS=admin
