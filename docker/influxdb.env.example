# Copy to docker/influxdb.env before the FIRST `docker compose up`.
# InfluxDB auto-setup runs once; values must match backend/.env
# (INFLUXDB_ORG / INFLUXDB_BUCKET / INFLUXDB_TOKEN).

DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change-me-please
DOCKER_INFLUXDB_INIT_ORG=sweetsignal
DOCKER_INFLUXDB_INIT_BUCKET=IOT-buck
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=my-super-secret-admin-token
